# BumpRace for GFOS (AmigaOS 3.2 with GFOpenUp), 68040/68060 + FPU, on
# GFOpenUp's SDL 2 (LIBS:GFOpenGPU/SDL2.module, SDL2_image.module and
# SDL2_mixer.module).
#
#   make -f amiga/Makefile.amigaos -j4 BR=/path/to/bumprace [STOVE=...]
#
# BR is upstream BumpRace at the commit package/bumprace.lock names, with
# amiga/patches applied (package/build-amiga.sh fetches and patches it).
# STOVE is a GFOpenAmigaGCC 16.2.0-open6 stove: its prefix/ has the
# compiler, the NDK and GFOpenGPU's SDL 2 kit (prefix/m68k-amigaos).
#
# The game is written for SDL 1.2: amiga/compat/ gives it the 1.2 calls it
# makes, on SDL 2 (sdl12on2.c). Upstream's <SDL.h> finds
# amiga/compat/SDL.h first. (The kit's own SDL 1.2, sdl12-compat, has no
# SDL_image or SDL_mixer for 1.2, which the game needs.)
#
# Output: build/amigaos/BumpRace/ (the drawer: BumpRace, Data/ with the
# pictures and sounds, User/ for the scores, ReadMe, the licences, with
# GlowIcons), build/amigaos/BumpRace.info and Install-BumpRace beside them.

BR      ?= ../bumprace
STOVE   ?= $(HOME)/AmiCradle/kitchen/stoves/os32-gcc16-open6
PREFIX  ?= $(STOVE)/prefix
SDL2KIT ?= $(PREFIX)/m68k-amigaos
CC      = $(PREFIX)/bin/m68k-amigaos-gcc
STRIP   = $(PREFIX)/bin/m68k-amigaos-strip
# hard float: GFOpenGPU's SDL 2 kit is built -m68881
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too). -fcommon: upstream defines some
# globals in more than one file, as old C compilers allowed.
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns -fno-math-errno
STD     = -std=gnu89 -fcommon -Wno-implicit-function-declaration -Wno-int-conversion

# SOUND: upstream's sound on (configure sets it when SDL_mixer is there)
DEFS    ?= -D__amigaos__ -DSOUND -DDATADIR=\"PROGDIR:Data\"
INC     = -Iamiga/compat -Iamiga -I$(BR)/src -I$(SDL2KIT)/include/SDL2
# NOIX: libnix (tests/host builds with the host's C library: NOIX=)
NOIX    ?= -noixemul
CFLAGS  = $(NOIX) $(OPT) $(STD) $(CPU) $(DEFS) $(INC)
LDFLAGS = $(NOIX) $(CPU)
LIBS    ?= -L$(SDL2KIT)/lib -lSDL2_image -lSDL2_mixer -lSDL2 -lm

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
OUT     = $(BUILD)/BumpRace
PROG    = BumpRace

# upstream's src/Makefile.am list, without net.c (only for -DNET)
GAME    = bumprace gfx particles menu options font
OBJS    = $(addprefix $(OBJDIR)/src/,$(addsuffix .o,$(GAME))) \
          $(OBJDIR)/amiga/sdl12on2.o $(OBJDIR)/amiga/amiga_start.o

all: $(OUT)/$(PROG) package

$(BUILD)/$(PROG).debug: $(OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

$(OUT)/$(PROG): $(BUILD)/$(PROG).debug
	@mkdir -p $(OUT)
	$(STRIP) -o $@ $<

package: $(OUT)/$(PROG) AMIGA_PORT.md amiga/Licences.txt
	mkdir -p $(OUT)/User $(OUT)/Data/gfx $(OUT)/Data/sound
	cp $(BR)/data/gfx/*.png $(BR)/data/gfx/*.jpg $(BR)/data/gfx/*.gif $(OUT)/Data/gfx/
	cp $(BR)/data/sound/*.ogg $(OUT)/Data/sound/
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp $(BR)/COPYING $(OUT)/COPYING.txt
	cp $(BR)/README $(OUT)/README-BumpRace.txt
	cp $(BR)/AUTHORS $(OUT)/AUTHORS.txt
	cp amiga/Licences.txt $(OUT)/Licences.txt
	cp amiga/icons/BumpRace.info amiga/icons/ReadMe.info $(OUT)/
	for f in COPYING.txt README-BumpRace.txt AUTHORS.txt Licences.txt; do \
	    cp amiga/icons/ReadMe.info $(OUT)/$$f.info; done
	cp amiga/icons/Data.info $(OUT)/User.info
	cp amiga/icons/Data.info $(OUT)/Data.info
	cp amiga/icons/BumpRace-drawer.info $(BUILD)/BumpRace.info
	cp amiga/Install-BumpRace amiga/Install-BumpRace.info $(BUILD)/

$(OBJDIR)/src/%.o: $(BR)/src/%.c $(wildcard $(BR)/src/*.h) amiga/compat/sdl12on2.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/sdl12on2.o: amiga/compat/sdl12on2.c amiga/compat/sdl12on2.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD)

.PHONY: all package clean
